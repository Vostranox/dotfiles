window-decoration      = none
window-padding-y       = 10
window-padding-balance = true
window-padding-color   = extend

background-blur    = true
background-opacity = 0.7


keybind = ctrl+u=paste_from_clipboard
keybind = ctrl+a=csi:B
keybind = ctrl+e=csi:A

cursor-style               = block
cursor-style-blink         = false
shell-integration-features = no-cursor

font-size   = 10.5
font-family = "JetBrainsMono Nerd Font Mono"

background           = #181818
foreground           = #c8c8d5
cursor-color         = #e8bf66
selection-background = #3e3b3c
selection-foreground = #c8c8d5

# For macOS
macos-option-as-alt = true

quick-terminal-position           = top
quick-terminal-autohide           = true
quick-terminal-animation-duration = 0.2
quick-terminal-size               = 55%, 100%

keybind = global:cmd+`=toggle_quick_terminal
keybind = cmd+shift+o=toggle_background_opacity